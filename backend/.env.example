NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8443
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friendsup
DATABASE_SSL=false
DATABASE_POOL_SIZE=20
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Safaricom Daraja sandbox credentials. Payments fail explicitly until configured.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Set these only for the one-time admin bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=FriendsUp Admin
